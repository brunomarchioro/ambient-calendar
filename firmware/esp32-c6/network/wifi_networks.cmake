# Redes Wi-Fi (ADR 0016): firmware/wifi-networks.json → C header. Fails the build on any invalid file.
# Script mode: cmake -DIN=<json> -DOUT=<header> -P wifi_networks.cmake
set(ALERTS_WIFI_NETWORKS_MAX 3)

function(_alerts_wifi_c_string out value)
	string(REPLACE "\\" "\\\\" value "${value}")
	string(REPLACE "\"" "\\\"" value "${value}")
	set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(alerts_wifi_networks_generate in out)
	if(NOT EXISTS "${in}")
		message(FATAL_ERROR "wifi: ${in} not found; copy firmware/wifi-networks.example.json")
	endif()
	file(READ "${in}" json)
	string(JSON type ERROR_VARIABLE err TYPE "${json}")
	if(err OR NOT type STREQUAL "ARRAY")
		message(FATAL_ERROR "wifi: ${in} must be a JSON array of {ssid, password}")
	endif()
	string(JSON count LENGTH "${json}")
	if(count LESS 1 OR count GREATER ALERTS_WIFI_NETWORKS_MAX)
		message(FATAL_ERROR "wifi: ${in} needs 1..${ALERTS_WIFI_NETWORKS_MAX} networks, has ${count}")
	endif()

	set(body "")
	math(EXPR last "${count} - 1")
	foreach(i RANGE ${last})
		string(JSON ssid_type ERROR_VARIABLE err TYPE "${json}" ${i} ssid)
		string(JSON ssid ERROR_VARIABLE err GET "${json}" ${i} ssid)
		string(LENGTH "${ssid}" ssid_len)
		if(err OR NOT ssid_type STREQUAL "STRING" OR ssid_len LESS 1 OR ssid_len GREATER 32)
			message(FATAL_ERROR "wifi: network ${i} needs ssid of 1..32 bytes")
		endif()
		string(JSON password_type ERROR_VARIABLE err TYPE "${json}" ${i} password)
		string(JSON password ERROR_VARIABLE err GET "${json}" ${i} password)
		string(LENGTH "${password}" password_len)
		# WPA2-PSK: 8..63 char passphrase or 64 hex digits.
		set(bad_psk FALSE)
		if(password_len EQUAL 64 AND NOT password MATCHES "^[0-9a-fA-F]+$")
			set(bad_psk TRUE)
		endif()
		if(err OR bad_psk OR NOT password_type STREQUAL "STRING" OR password_len LESS 8 OR password_len GREATER 64)
			message(FATAL_ERROR "wifi: network ${i} (${ssid}) needs password of 8..63 chars or 64 hex digits (WPA2)")
		endif()
		_alerts_wifi_c_string(c_ssid "${ssid}")
		_alerts_wifi_c_string(c_password "${password}")
		string(APPEND body "\t{${c_ssid}, ${c_password}},\n")
	endforeach()

	set(tmp "${out}.tmp")
	file(WRITE "${tmp}" "// Generated from ${in} — do not commit (contains secrets)\n#pragma once\n\n#include \"wifi_select.h\"\n\n#define ALERTS_WIFI_NETWORK_COUNT ${count}\n\nstatic const alerts_wifi_network_t ALERTS_WIFI_NETWORKS[ALERTS_WIFI_NETWORK_COUNT] = {\n${body}};\n")
	configure_file("${tmp}" "${out}" COPYONLY)
	file(REMOVE "${tmp}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
	alerts_wifi_networks_generate("${IN}" "${OUT}")
endif()
