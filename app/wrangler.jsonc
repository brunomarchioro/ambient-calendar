{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "account_id": "afdf2c8fa804b0d929040ad1d2bdfe72",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "worker.ts",
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "04a6fda9e93947408133432e985f2944",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ambient_calendar",
      "database_id": "5f2b58a6-635a-4e55-9e21-30157e3b6a34",
      "migrations_dir": "db/migrations",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
